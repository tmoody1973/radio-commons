# Backstory's Convex deployment (https://<name>.convex.cloud). Server-only.
BACKSTORY_CONVEX_URL=

# Alexa+ simulator (/simulator). Server-only.
DEEPGRAM_API_KEY=
SIM_AWS_ACCESS_KEY_ID=
SIM_AWS_SECRET_ACCESS_KEY=
SIM_AWS_REGION=us-east-1
SIM_POLLY_VOICE=Ruth
SIM_PASSCODE=
MCP_URL=http://localhost:3000/api/mcp
# Amazon Location keys, us-east-1, Sensitive in Vercel. Server: GetStaticMap only (the /api/map picture).
AMAZON_LOCATION_API_KEY=
# Browser: GetTile only (the fullscreen pan-and-zoom map; this one is visible in the card page).
AMAZON_LOCATION_BROWSER_KEY=

# Listener account linking (Finds tools). Clerk "Radio Milwaukee Listeners" app; tokens are checked locally, no network call.
CLERK_LISTENER_ISSUER=
# PEM public key from ${CLERK_LISTENER_ISSUER}/.well-known/jwks.json (Clerk dashboard: API keys > JWT public key).
CLERK_LISTENER_JWT_KEY=
CLERK_LISTENER_OAUTH_CLIENT_ID=
# The MCP endpoint's public URL for /.well-known/oauth-protected-resource (default: <origin>/api/mcp). Production: https://radio-commons.vercel.app/api/mcp
MCP_RESOURCE_URL=

# Playlist tools (find_song_played, get_track_story, Finds). Server-only.
# The playlist Convex deployment URL (https://<name>.convex.cloud).
PLAYLIST_CONVEX_URL=
# Must equal RADIO_COMMONS_SERVER_KEY on the playlist Convex deployment.
RADIO_COMMONS_SERVER_KEY=

# Apple Music connect page (/connect/apple-music): Clerk "Radio Milwaukee Listeners" app, default Clerk env names.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Playlist deployment (https://<name>.convex.cloud), read by the browser for the public appleMusic:getDeveloperToken.
NEXT_PUBLIC_PLAYLIST_CONVEX_URL=

# Public contact address shown on /privacy. If unset, the page says "contact Radio Milwaukee".
PRIVACY_CONTACT_EMAIL=

# Simulator account linking (Link Radio Milwaukee account), like Alexa's: OAuth 2.1 + PKCE against the listener Clerk app.
# The confidential client's secret (token endpoint auth is HTTP Basic). Server-only.
CLERK_LISTENER_OAUTH_CLIENT_SECRET=
# Seals the simulator's login cookies: `openssl rand -base64 32`. Unset = linking off.
SIM_SESSION_SECRET=
# Where the simulator runs, for the OAuth redirect: http://localhost:3000 locally, https://radio-commons.vercel.app in prod.
SIM_PUBLIC_ORIGIN=

# Station briefing: the 88Nine weekly newsletter (Mailchimp; key ends in -<region>, e.g. -us7). Server-side only.
MAILCHIMP_API_KEY=

# "Support Radio Milwaukee" (Amazon Pay SANDBOX only; no real money, ever). All five or giving is off: the tool and
# /give then say "Donations aren't set up yet". Set up per docs/GIVE-SETUP.md. Server-only; mark the key and secret Sensitive in Vercel.
AMAZON_PAY_PUBLIC_KEY_ID=
# The sandbox private key (.pem) from Integration Central, on one line with literal \n between lines.
AMAZON_PAY_PRIVATE_KEY=
AMAZON_PAY_MERCHANT_ID=
# amzn1.application-oa2-client.… from Integration Central.
AMAZON_PAY_STORE_ID=
# Seals the listener id in /give links: `openssl rand -base64 32`.
GIVE_TOKEN_SECRET=
# Monthly memberships are saved in the listener's Clerk privateMetadata using CLERK_SECRET_KEY (above).
