    "locales": {
      "en-US": {
        "default": "DEFAULT",
        "name": {
          "value": "Radio Milwaukee",
          "spokenForm": {
            "format": "ipa",
            "value": "ˈreɪdioʊ mɪlˈwɔːki"
          }
        },
        "shortDescription": "Find Radio Milwaukee stories, songs and local shows",
        "fullDescription": "Ask Alexa about Radio Milwaukee, Milwaukee's public music station. Find a podcast story you only half remember, from This Bites, Uniquely Milwaukee, Ladies First, artist interviews, Milwaukee Music Premieres and Studio Milwaukee Sessions, and see the places it mentions on a map. Hear what 88Nine, HYFIN, Rhythm Lab and 414 Music just played or are playing right now, and listen live. Ask when the station last played a song, and get a song's credits. Find concerts by artists the station plays, plus Milwaukee events and staff picks you can add to your calendar. Ask who is on 88Nine right now and when shows air. Get a weekly station briefing, or ask \"What can Radio Milwaukee do?\" to hear the rest.\n\nWith a free Radio Milwaukee account, you can also save songs to your Finds (and to your Apple Music library, once you connect Apple Music), follow artists, and ask \"What's new for me?\" to hear their latest spins, local shows and station stories.",
        "examplePhrases": [
          "What's on Radio Milwaukee right now",
          "Save that song",
          "What was that This Bites episode about frugal dining",
          "What's new for me"
        ],
        "privacyAndCompliance": {
          "privacyPolicyUrl": "https://radio-commons.vercel.app/privacy",
          "termsOfUseUrl": "https://radio-commons.vercel.app/terms"
        },
